---
import { localizePath, t } from '../../i18n';
import type { Locale } from '../../i18n';
import { ArrowLeft, ArrowUpRight, Code2, PenTool, LayoutTemplate } from 'lucide-react';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const homeHref = localizePath('/', locale);
const isId = locale === 'id';

const coreTeam = [
  {
    name: 'risuunava',
    username: 'risuunava',
    github: 'https://github.com/risuunava',
    avatar: 'https://avatars.githubusercontent.com/risuunava',
    role: isId ? 'Project Owner & Lead Developer' : 'Project Owner & Lead Developer',
    description: isId
      ? 'Arsitektur sistem utama, pengembangan perangkat lunak native WPF, dan manajemen repositori Notchi.'
      : 'Core system architecture, native WPF software engineering, and overall repository management.',
    icon: Code2,
    badge: isId ? 'Pendiri & Pemilik Proyek' : 'Project Lead',
  },
];

const contributors = [
  {
    name: 'Aren',
    username: 'Arennbukangula',
    github: 'https://github.com/Arennbukangula',
    avatar: 'https://avatars.githubusercontent.com/Arennbukangula',
    role: isId ? 'Technical Writer & Web Developer' : 'Technical Writer & Web Developer',
    description: isId
      ? 'Menyusun dan menyempurnakan dokumentasi teknis, serta membangun dan memelihara website resmi Notchi.'
      : 'Authoring and refining technical documentation, plus building and maintaining the official website for Notchi.',
    icon: LayoutTemplate,
  },
  {
    name: 'Pataya',
    username: 'patayaaaa',
    github: 'https://github.com/patayaaaa',
    avatar: 'https://avatars.githubusercontent.com/patayaaaa',
    role: isId ? 'UI/UX Designer' : 'UI/UX Designer',
    description: isId
      ? 'Merancang dan mendesain ulang antarmuka visual Notchi untuk pengalaman pengguna yang intuitif.'
      : 'Designed and redesigned the Notchi visual user interface and ergonomic interaction patterns.',
    icon: PenTool,
  },
];
---

<div class="w-full bg-neutral-950 text-white antialiased">
  {/* Header Section */}
  <section class="border-b border-neutral-800 bg-neutral-950">
    <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
      <a
        href={homeHref}
        class="inline-flex items-center gap-2 text-xs font-mono text-neutral-400 hover:text-white transition-colors"
      >
        <ArrowLeft className="size-3.5" />
        <span>{t(locale, 'archive.backHome')}</span>
      </a>

      <div class="mt-6 max-w-3xl">
        <p class="text-xs font-mono uppercase tracking-wider text-neutral-500">
          {isId ? 'Orang di Balik Proyek' : 'People Behind Notchi'}
        </p>
        <h1 class="mt-2 text-3xl sm:text-5xl font-semibold tracking-tight text-white">
          {isId ? 'Tim & Kontributor' : 'Team & Contributors'}
        </h1>
        <p class="mt-3 text-sm sm:text-base text-neutral-400 leading-relaxed font-normal">
          {isId
            ? 'Individu yang mendedikasikan waktu dan keahlian mereka dalam merancang, mengembangkan, dan memelihara proyek Notchi.'
            : 'The dedicated individuals engineering the codebase, crafting interfaces, and maintaining the Notchi ecosystem.'}
        </p>
      </div>
    </div>
  </section>

  {/* Content Container */}
  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8 space-y-16">
    {/* Core Team Section */}
    <section>
      <div class="pb-4 border-b border-neutral-800 flex items-center justify-between">
        <div>
          <span class="text-xs font-mono text-neutral-500 uppercase tracking-wider">
            {isId ? 'Tim Utama' : 'Core Team'}
          </span>
          <h2 class="mt-1 text-xl font-semibold text-white tracking-tight">
            {isId ? 'Pengembang Utama' : 'Lead Architect'}
          </h2>
        </div>
      </div>

      <div class="mt-6 grid grid-cols-1">
        {
          coreTeam.map((member) => (
            <div class="border border-neutral-800 bg-neutral-900/40 p-6 sm:p-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 transition-colors hover:border-neutral-700 hover:bg-neutral-900/60">
              <div class="flex items-start sm:items-center gap-5">
                <img
                  src={member.avatar}
                  alt={member.name}
                  class="size-16 rounded-none border border-neutral-700 bg-neutral-800 object-cover shrink-0"
                  loading="eager"
                  referrerpolicy="no-referrer"
                />
                <div>
                  <div class="flex flex-wrap items-center gap-2.5">
                    <h3 class="text-lg font-semibold text-white font-sans">{member.name}</h3>
                    <span class="border border-blue-500/30 bg-blue-500/10 px-2.5 py-0.5 text-[10px] font-mono text-blue-400">
                      {member.badge}
                    </span>
                  </div>
                  <p class="text-xs font-mono text-emerald-400 mt-1">{member.role}</p>
                  <p class="text-xs sm:text-sm text-neutral-400 leading-relaxed mt-2 max-w-xl font-normal">
                    {member.description}
                  </p>
                </div>
              </div>

              <a
                href={member.github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex h-9 items-center gap-1.5 border border-neutral-800 bg-neutral-900 px-4 text-xs font-mono text-neutral-300 hover:bg-neutral-800 hover:text-white transition-colors shrink-0"
              >
                <svg class="size-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
                </svg>
                <span>@{member.username}</span>
                <ArrowUpRight className="size-3.5" />
              </a>
            </div>
          ))
        }
      </div>
    </section>

    {/* Contributors Section */}
    <section>
      <div class="pb-4 border-b border-neutral-800">
        <span class="text-xs font-mono text-neutral-500 uppercase tracking-wider">
          {isId ? 'Kontributor' : 'Contributors'}
        </span>
        <h2 class="mt-1 text-xl font-semibold text-white tracking-tight">
          {isId ? 'Dokumentasi & Desain' : 'Design & Documentation'}
        </h2>
      </div>

      <div class="mt-6 grid grid-cols-1 border-t border-l border-neutral-800 sm:grid-cols-2">
        {
          contributors.map((member) => (
            <div class="border-r border-b border-neutral-800 bg-neutral-950 p-6 flex flex-col justify-between transition-colors hover:bg-neutral-900/40">
              <div>
                <div class="flex items-center gap-3">
                  <img
                    src={member.avatar}
                    alt={member.name}
                    class="size-12 rounded-none border border-neutral-800 bg-neutral-800 object-cover shrink-0"
                    loading="lazy"
                    referrerpolicy="no-referrer"
                  />
                  <div>
                    <h3 class="text-base font-semibold text-white">{member.name}</h3>
                    <p class="text-xs font-mono text-neutral-400">@{member.username}</p>
                  </div>
                </div>

                <div class="mt-4">
                  <span class="text-xs font-mono text-emerald-400 block font-medium">{member.role}</span>
                  <p class="mt-2 text-xs text-neutral-400 leading-relaxed font-normal">
                    {member.description}
                  </p>
                </div>
              </div>

              <div class="mt-6 pt-4 border-t border-neutral-900 flex justify-end">
                <a
                  href={member.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-xs font-mono text-neutral-400 hover:text-white transition-colors"
                >
                  <span>GitHub Profile</span>
                  <ArrowUpRight className="size-3" />
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    {/* How to Contribute CTA */}
    <section class="border border-neutral-800 bg-neutral-900/30 p-6 sm:p-8">
      <h3 class="text-lg font-semibold text-white">
        {isId ? 'Tertarik Berkontribusi?' : 'Interested in Contributing?'}
      </h3>
      <p class="mt-2 text-xs sm:text-sm text-neutral-400 leading-relaxed font-normal max-w-2xl">
        {isId
          ? 'Kami menyambut setiap bentuk kontribusi, baik pelaporan bug, penyempurnaan kode fitur, maupun dokumentasi. Silakan buka issue atau fork repositori Notchi di GitHub.'
          : 'We welcome all contributions from bug reports to code improvements and localization. Check out the issues tab or fork the repository on GitHub.'}
      </p>

      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="https://github.com/risuunava/Notchi/blob/main/CONTRIBUTORS.md"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-9 items-center justify-center gap-1.5 bg-blue-600 px-4 text-xs font-mono font-medium text-white hover:bg-blue-500 transition-colors"
        >
          <span>CONTRIBUTORS.md</span>
          <ArrowUpRight className="size-3.5" />
        </a>
        <a
          href="https://github.com/risuunava/Notchi"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-9 items-center justify-center gap-1.5 border border-neutral-800 bg-neutral-900 px-4 text-xs font-mono font-medium text-neutral-300 hover:text-white hover:bg-neutral-800 transition-colors"
        >
          <svg class="size-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          <span>GitHub Repository</span>
        </a>
      </div>
    </section>
  </div>
</div>
