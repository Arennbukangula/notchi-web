---
import NotchiInstallerGrid from '../react/NotchiInstallerGrid';
import { localizePath, t } from '../../i18n';
import type { Locale } from '../../i18n';
import type { Release } from '../../lib/github';
import { ArrowLeft } from 'lucide-react';

interface Props {
  releases: Release[];
  mobileReleases?: Release[];
  locale: Locale;
  initialTab?: 'windows' | 'mobile';
}

const { releases, mobileReleases = [], locale, initialTab = 'windows' } = Astro.props;
const homeHref = localizePath('/', locale);
const isId = locale === 'id';
---

<section class="border-b border-neutral-800 bg-neutral-950 text-white">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
    <a
      href={homeHref}
      class="inline-flex items-center gap-2 text-xs font-mono text-neutral-400 hover:text-white transition-colors"
    >
      <ArrowLeft className="size-3.5" />
      <span>{t(locale, 'archive.backHome')}</span>
    </a>

    <div class="mt-6 max-w-3xl">
      <p class="text-xs font-mono uppercase tracking-wider text-neutral-500">
        {isId ? "Distribusi Resmi" : "Official Downloads"}
      </p>
      <h1 class="mt-2 text-3xl sm:text-5xl font-semibold tracking-tight text-white">
        Installer
      </h1>
      <p class="mt-3 text-sm sm:text-base text-neutral-400 leading-relaxed font-normal">
        {isId
          ? "Unduh paket installer dan portabel resmi untuk Windows desktop maupun aplikasi pendamping Android."
          : "Download official installer and portable packages for Windows desktop or the Android companion application."}
      </p>
    </div>
  </div>
</section>

<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
  <NotchiInstallerGrid
    windowsReleases={releases}
    mobileReleases={mobileReleases}
    locale={locale}
    initialTab={initialTab}
    client:load
  />
</section>
