---
import { localizePath, t } from '../../i18n';
import type { Locale } from '../../i18n';
import { getReleases } from '../../lib/github';
import NotchiClaimReward from '../react/NotchiClaimReward';
import { ArrowLeft, Gift } from 'lucide-react';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const homeHref = localizePath('/', locale);
const isId = locale === 'id';

const releases = await getReleases();
const totalDownloads = releases.reduce((sum, release) => {
  return (
    sum +
    release.assets.reduce((assetSum, asset) => {
      return asset.kind !== 'checksum' ? assetSum + asset.downloadCount : assetSum;
    }, 0)
  );
}, 0);

const siteKey = process.env.PUBLIC_TURNSTILE_SITE_KEY || '';
---

<div class="w-full bg-neutral-950 text-white antialiased">
  {/* Header Section */}
  <section class="border-b border-neutral-800 bg-neutral-950">
    <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
      <a
        href={homeHref}
        class="inline-flex items-center gap-2 text-xs font-mono text-neutral-400 hover:text-white transition-colors"
      >
        <ArrowLeft className="size-3.5" />
        <span>{t(locale, 'archive.backHome')}</span>
      </a>

      <div class="mt-6 max-w-3xl">
        <div class="inline-flex items-center gap-2 border border-blue-500/30 bg-blue-500/10 px-2.5 py-0.5 text-[11px] font-mono text-blue-400 mb-3">
          <Gift className="size-3.5" />
          <span>{isId ? 'Hadiah Milestone' : 'Milestone Rewards'}</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-semibold tracking-tight text-white">
          {t(locale, 'claim.title')}
        </h1>
        <p class="mt-3 text-sm sm:text-base text-neutral-400 leading-relaxed font-normal">
          {t(locale, 'claim.subtitle')}
        </p>
      </div>
    </div>
  </section>

  {/* Main Content */}
  <main class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
    <NotchiClaimReward
      client:load
      locale={locale}
      totalDownloads={totalDownloads}
      milestoneTarget={100}
      siteKey={siteKey}
    />
  </main>
</div>
