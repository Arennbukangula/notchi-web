---
import ChecksumField from '../ChecksumField.astro';
import Doodle from '../Doodle.astro';
import DownloadButton from '../DownloadButton.astro';
import Faq from '../Faq.astro';
import { localizePath, t } from '../../i18n';
import type { Locale } from '../../i18n';
import { getReleases } from '../../lib/github';
import { getLatestStable } from '../../lib/version';
import { siteConfig } from '../../site.config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const releases = await getReleases();
const latest = getLatestStable(releases);
const installer = latest?.primaryInstaller;
const homeHref = localizePath('/', locale);

const headingClass = 'display mt-3 scroll-mt-28 text-2xl sm:text-3xl';
const bodyClass = 'mt-3 text-sm leading-7 text-muted';

const installSteps = [
  {
    title: t(locale, 'home.install.step1.title'),
    description: t(locale, 'home.install.step1.description'),
  },
  {
    title: t(locale, 'home.install.step2.title'),
    description: t(locale, 'home.install.step2.description'),
  },
  {
    title: t(locale, 'home.install.step3.title'),
    description: t(locale, 'home.install.step3.description'),
  },
];

const faqItems = [
  {
    question: t(locale, 'faq.windows.question'),
    answer: t(locale, 'faq.windows.answer'),
  },
  {
    question: t(locale, 'faq.smartscreen.question'),
    answer: t(locale, 'faq.smartscreen.answer'),
  },
  {
    question: t(locale, 'faq.admin.question'),
    answer: t(locale, 'faq.admin.answer'),
  },
  {
    question: t(locale, 'faq.rollback.question'),
    answer: t(locale, 'faq.rollback.answer'),
  },
  {
    question: t(locale, 'faq.notes.question'),
    answer: t(locale, 'faq.notes.answer'),
  },
  {
    question: t(locale, 'faq.uninstall.question'),
    answer: t(locale, 'faq.uninstall.answer'),
  },
];
---

<div class="pattern-dots border-b-[2.5px] border-line">
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
    <a
      href={homeHref}
      class="inline-flex items-center gap-2 text-sm font-bold text-muted transition-colors hover:text-ink"
    >
      <span
        class="flex h-7 w-7 items-center justify-center rounded-md border-2 border-line bg-panel text-ink shadow-brutal-sm"
        aria-hidden="true"
      >
        ←
      </span>
      {t(locale, 'docs.backHome')}
    </a>

    <div class="mt-8 flex items-end justify-between gap-6">
      <div>
        <p class="eyebrow">{t(locale, 'nav.docs')}</p>
        <h1 class="display mt-3 text-4xl sm:text-6xl">
          {t(locale, 'docs.title')}
        </h1>
      </div>
      <Doodle variant="squiggle" class="hidden h-8 w-20 sm:block" />
    </div>

    <p class="mt-4 max-w-2xl text-base leading-7 text-muted">
      {t(locale, 'docs.description')}
    </p>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      {latest && <DownloadButton release={latest} locale={locale} />}
      <span class="sticker">{t(locale, 'home.platform')}</span>
    </div>
  </div>
</div>

<div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
  <section aria-labelledby="docs-install">
    <p class="eyebrow">01</p>
    <h2 id="docs-install" class={headingClass}>{t(locale, 'docs.installTitle')}</h2>
    <p class={bodyClass}>{t(locale, 'docs.installIntro')}</p>

    <ol class="mt-6 space-y-3">
      {
        installSteps.map((step, index) => (
          <li class="card-brutal flex gap-4 p-4 sm:p-5">
            <span class="sticker sticker-accent h-8 w-8 shrink-0 !px-0">{index + 1}</span>
            <div>
              <h3 class="text-sm font-bold text-ink">{step.title}</h3>
              <p class="mt-1 text-sm leading-6 text-muted">{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mt-12" aria-labelledby="docs-verify">
    <p class="eyebrow">02</p>
    <h2 id="docs-verify" class={headingClass}>{t(locale, 'docs.verifyTitle')}</h2>
    <p class={bodyClass}>{t(locale, 'docs.verifyBody')}</p>
    <p
      class="mt-3 rounded-xl border-2 border-line bg-panel px-4 py-3 text-sm leading-6 text-ink shadow-brutal-sm"
    >
      {t(locale, 'docs.verifyNote')}
    </p>
    {
      installer && (
        <div class="mt-5">
          <ChecksumField file={installer.name} hash={installer.sha256} locale={locale} />
        </div>
      )
    }
  </section>

  <section class="mt-12" aria-labelledby="docs-smartscreen">
    <p class="eyebrow">03</p>
    <h2 id="docs-smartscreen" class={headingClass}>{t(locale, 'docs.smartScreenTitle')}</h2>
    <div class="card-brutal mt-4 flex gap-4 bg-[#08080b] p-5 text-white sm:p-6">
      <span
        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border-2 border-white bg-accent font-display text-lg text-accent-contrast"
        aria-hidden="true"
      >
        !
      </span>
      <p class="text-sm leading-7 text-white/75">
        {t(locale, 'docs.smartScreenBody')}
      </p>
    </div>
  </section>

  <div class="mt-12 grid gap-4 sm:grid-cols-2">
    <section class="card-brutal p-5" aria-labelledby="docs-autostart">
      <h2 id="docs-autostart" class="font-display text-xl tracking-tight text-ink">
        {t(locale, 'docs.autostartTitle')}
      </h2>
      <p class={bodyClass}>{t(locale, 'docs.autostartBody')}</p>
    </section>

    <section class="card-brutal p-5" aria-labelledby="docs-storage">
      <h2 id="docs-storage" class="font-display text-xl tracking-tight text-ink">
        {t(locale, 'docs.storageTitle')}
      </h2>
      <p class={bodyClass}>{t(locale, 'docs.storageBody')}</p>
    </section>

    <section class="card-brutal p-5 sm:col-span-2" aria-labelledby="docs-uninstall">
      <h2 id="docs-uninstall" class="font-display text-xl tracking-tight text-ink">
        {t(locale, 'docs.uninstallTitle')}
      </h2>
      <p class={bodyClass}>{t(locale, 'docs.uninstallBody')}</p>
    </section>
  </div>
</div>

<Faq title={t(locale, 'docs.faqTitle')} items={faqItems} />

<div class="mx-auto max-w-3xl px-4 pb-16 sm:px-6">
  <section class="card-brutal p-6" aria-labelledby="docs-bugs">
    <p class="eyebrow">05</p>
    <h2 id="docs-bugs" class="display mt-3 text-2xl sm:text-3xl">
      {t(locale, 'docs.bugsTitle')}
    </h2>
    <p class="mt-3 text-sm leading-7 text-muted">{t(locale, 'docs.bugsBody')}</p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a
        href={siteConfig.github.issuesUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary"
      >
        {t(locale, 'docs.reportIssue')}
        <span aria-hidden="true">↗</span>
      </a>
      <a
        href={siteConfig.github.url}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-secondary"
      >
        {t(locale, 'docs.viewSource')}
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</div>
