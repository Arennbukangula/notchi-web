---
import NotchiFaq from '../react/NotchiFaq';
import { localizePath, t } from '../../i18n';
import type { Locale } from '../../i18n';
import { getReleases } from '../../lib/github';
import { getLatestStable } from '../../lib/version';
import { siteConfig } from '../../site.config';
import { ArrowLeft, ArrowUpRight, Download, ShieldCheck, AlertTriangle } from 'lucide-react';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const releases = await getReleases();
const latest = getLatestStable(releases);
const installer = latest?.primaryInstaller;
const homeHref = localizePath('/', locale);
const downloadHref = localizePath(siteConfig.routes.download, locale);
const isId = locale === 'id';

const installSteps = [
  {
    num: '01',
    title: t(locale, 'home.install.step1.title'),
    description: t(locale, 'home.install.step1.description'),
  },
  {
    num: '02',
    title: t(locale, 'home.install.step2.title'),
    description: t(locale, 'home.install.step2.description'),
  },
  {
    num: '03',
    title: t(locale, 'home.install.step3.title'),
    description: t(locale, 'home.install.step3.description'),
  },
];

const faqItems = [
  {
    question: t(locale, 'faq.windows.question'),
    answer: t(locale, 'faq.windows.answer'),
  },
  {
    question: t(locale, 'faq.smartscreen.question'),
    answer: t(locale, 'faq.smartscreen.answer'),
  },
  {
    question: t(locale, 'faq.admin.question'),
    answer: t(locale, 'faq.admin.answer'),
  },
  {
    question: t(locale, 'faq.rollback.question'),
    answer: t(locale, 'faq.rollback.answer'),
  },
  {
    question: t(locale, 'faq.notes.question'),
    answer: t(locale, 'faq.notes.answer'),
  },
  {
    question: t(locale, 'faq.uninstall.question'),
    answer: t(locale, 'faq.uninstall.answer'),
  },
];
---

<div class="w-full bg-neutral-950 text-white antialiased">
  {/* Header Section */}
  <section class="border-b border-neutral-800 bg-neutral-950">
    <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16">
      <a
        href={homeHref}
        class="inline-flex items-center gap-2 text-xs font-mono text-neutral-400 hover:text-white transition-colors"
      >
        <ArrowLeft className="size-3.5" />
        <span>{t(locale, 'docs.backHome')}</span>
      </a>

      <div class="mt-6">
        <p class="text-xs font-mono uppercase tracking-wider text-neutral-500">
          {t(locale, 'nav.docs')}
        </p>
        <h1 class="mt-2 text-3xl sm:text-5xl font-semibold tracking-tight text-white">
          {t(locale, 'docs.title')}
        </h1>
        <p class="mt-3 text-sm sm:text-base text-neutral-400 leading-relaxed font-normal">
          {t(locale, 'docs.description')}
        </p>
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        {
          installer ? (
            <a
              href={installer.url}
              class="inline-flex h-10 items-center justify-center gap-2 bg-blue-600 px-5 text-xs font-mono font-medium text-white hover:bg-blue-500 transition-colors"
            >
              <Download className="size-3.5" />
              <span>{isId ? 'Unduh Installer' : 'Download Setup'} ({latest?.tag})</span>
            </a>
          ) : (
            <a
              href={downloadHref}
              class="inline-flex h-10 items-center justify-center gap-2 bg-blue-600 px-5 text-xs font-mono font-medium text-white hover:bg-blue-500 transition-colors"
            >
              <Download className="size-3.5" />
              <span>Installer</span>
            </a>
          )
        }
        <span class="inline-flex h-10 items-center border border-neutral-800 bg-neutral-900 px-3 text-xs font-mono text-neutral-400">
          {t(locale, 'home.platform')}
        </span>
      </div>
    </div>
  </section>

  {/* Main Content Sections */}
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 space-y-16">
    {/* 01 Installation Guide */}
    <section aria-labelledby="docs-install">
      <div class="pb-4 border-b border-neutral-800">
        <p class="text-xs font-mono text-neutral-500">01</p>
        <h2 id="docs-install" class="mt-1 text-2xl font-semibold text-white tracking-tight">
          {t(locale, 'docs.installTitle')}
        </h2>
        <p class="mt-1 text-sm text-neutral-400 font-normal">{t(locale, 'docs.installIntro')}</p>
      </div>

      <div class="mt-6 grid grid-cols-1 border-t border-l border-neutral-800 sm:grid-cols-3">
        {
          installSteps.map((step) => (
            <div class="border-r border-b border-neutral-800 bg-neutral-950 p-6">
              <span class="font-mono text-xl font-bold text-neutral-600">{step.num}</span>
              <h3 class="mt-3 text-sm font-semibold text-white">{step.title}</h3>
              <p class="mt-2 text-xs text-neutral-400 leading-relaxed font-normal">{step.description}</p>
            </div>
          ))
        }
      </div>
    </section>

    {/* 02 Checksum & Verification */}
    <section aria-labelledby="docs-verify">
      <div class="pb-4 border-b border-neutral-800">
        <p class="text-xs font-mono text-neutral-500">02</p>
        <h2 id="docs-verify" class="mt-1 text-2xl font-semibold text-white tracking-tight">
          {t(locale, 'docs.verifyTitle')}
        </h2>
        <p class="mt-1 text-sm text-neutral-400 font-normal">{t(locale, 'docs.verifyBody')}</p>
      </div>

      <div class="mt-6 border border-neutral-800 bg-neutral-900/40 p-5 text-xs text-neutral-400 leading-relaxed">
        <div class="flex items-start gap-2.5">
          <ShieldCheck className="size-4 text-emerald-400 shrink-0 mt-0.5" />
          <p>{t(locale, 'docs.verifyNote')}</p>
        </div>
        {
          installer && installer.sha256 && (
            <div class="mt-4 pt-4 border-t border-neutral-800 font-mono">
              <span class="text-neutral-500 block text-[11px] uppercase">SHA-256 for {installer.name}:</span>
              <code class="mt-1 block break-all text-xs text-emerald-400 bg-black/60 p-2.5 border border-neutral-800">
                {installer.sha256}
              </code>
            </div>
          )
        }
      </div>
    </section>

    {/* 03 Windows SmartScreen */}
    <section aria-labelledby="docs-smartscreen">
      <div class="pb-4 border-b border-neutral-800">
        <p class="text-xs font-mono text-neutral-500">03</p>
        <h2 id="docs-smartscreen" class="mt-1 text-2xl font-semibold text-white tracking-tight">
          {t(locale, 'docs.smartScreenTitle')}
        </h2>
      </div>

      <div class="mt-6 border border-neutral-800 bg-neutral-900/40 p-5 text-xs sm:text-sm text-neutral-300 leading-relaxed">
        <div class="flex items-start gap-3">
          <AlertTriangle className="size-4 text-amber-400 shrink-0 mt-0.5" />
          <p class="text-neutral-400">{t(locale, 'docs.smartScreenBody')}</p>
        </div>
      </div>
    </section>

    {/* 04 Storage & Auto-start */}
    <section>
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="border border-neutral-800 bg-neutral-950 p-6">
          <h3 class="text-base font-semibold text-white">{t(locale, 'docs.autostartTitle')}</h3>
          <p class="mt-2 text-xs sm:text-sm text-neutral-400 leading-relaxed font-normal">{t(locale, 'docs.autostartBody')}</p>
        </div>

        <div class="border border-neutral-800 bg-neutral-950 p-6">
          <h3 class="text-base font-semibold text-white">{t(locale, 'docs.storageTitle')}</h3>
          <p class="mt-2 text-xs sm:text-sm text-neutral-400 leading-relaxed font-normal">{t(locale, 'docs.storageBody')}</p>
        </div>

        <div class="border border-neutral-800 bg-neutral-950 p-6 sm:col-span-2">
          <h3 class="text-base font-semibold text-white">{t(locale, 'docs.uninstallTitle')}</h3>
          <p class="mt-2 text-xs sm:text-sm text-neutral-400 leading-relaxed font-normal">{t(locale, 'docs.uninstallBody')}</p>
        </div>
      </div>
    </section>

    {/* Issues and Source */}
    <section class="border border-neutral-800 bg-neutral-900/30 p-6 sm:p-8">
      <h3 class="text-lg font-semibold text-white">{t(locale, 'docs.bugsTitle')}</h3>
      <p class="mt-2 text-xs sm:text-sm text-neutral-400 leading-relaxed font-normal">{t(locale, 'docs.bugsBody')}</p>

      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href={siteConfig.github.issuesUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-9 items-center justify-center gap-1.5 bg-blue-600 px-4 text-xs font-mono font-medium text-white hover:bg-blue-500 transition-colors"
        >
          <span>{t(locale, 'docs.reportIssue')}</span>
          <ArrowUpRight className="size-3.5" />
        </a>
        <a
          href={siteConfig.github.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-9 items-center justify-center gap-1.5 border border-neutral-800 bg-neutral-900 px-4 text-xs font-mono font-medium text-neutral-300 hover:text-white hover:bg-neutral-800 transition-colors"
        >
          <span>{t(locale, 'docs.viewSource')}</span>
          <ArrowUpRight className="size-3.5" />
        </a>
      </div>
    </section>
  </div>

  {/* FAQ Component */}
  <NotchiFaq locale={locale} items={faqItems} client:visible />
</div>
