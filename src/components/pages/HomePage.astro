---
import Faq from '../Faq.astro';
import FeatureGrid from '../FeatureGrid.astro';
import Hero from '../Hero.astro';
import InstallGuide from '../InstallGuide.astro';
import Screenshots from '../Screenshots.astro';
import SystemRequirements from '../SystemRequirements.astro';
import { t } from '../../i18n';
import type { Locale } from '../../i18n';
import { getReleases } from '../../lib/github';
import { getLatestStable } from '../../lib/version';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const releases = await getReleases();
const latest = getLatestStable(releases);

const faqItems = [
  {
    question: t(locale, 'faq.windows.question'),
    answer: t(locale, 'faq.windows.answer'),
  },
  {
    question: t(locale, 'faq.smartscreen.question'),
    answer: t(locale, 'faq.smartscreen.answer'),
  },
  {
    question: t(locale, 'faq.admin.question'),
    answer: t(locale, 'faq.admin.answer'),
  },
  {
    question: t(locale, 'faq.rollback.question'),
    answer: t(locale, 'faq.rollback.answer'),
  },
];
---

<Hero latest={latest} locale={locale} />
<Screenshots locale={locale} />
<FeatureGrid locale={locale} />
<SystemRequirements locale={locale} />
<InstallGuide locale={locale} />
<Faq title={t(locale, 'docs.faqTitle')} items={faqItems} />
