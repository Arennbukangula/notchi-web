---
import NotchiHero from '../react/NotchiHero';
import NotchiScreenshots from '../react/NotchiScreenshots';
import NotchiBentoGrid from '../react/NotchiBentoGrid';
import NotchiReleasesSection from '../react/NotchiReleasesSection';
import NotchiRequirements from '../react/NotchiRequirements';
import NotchiTestimonials from '../react/NotchiTestimonials';
import NotchiFaq from '../react/NotchiFaq';
import { t, localizePath } from '../../i18n';
import type { Locale } from '../../i18n';
import { getReleases } from '../../lib/github';
import { getLatestStable } from '../../lib/version';
import { formatFileSize } from '../../lib/format';
import { siteConfig } from '../../site.config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const releases = await getReleases();
const latest = getLatestStable(releases);
const installer = latest?.primaryInstaller;
const versionsHref = localizePath(siteConfig.routes.download, locale);
const mobileHref = localizePath(siteConfig.routes.mobile, locale);

const faqItems = [
  {
    question: t(locale, 'faq.windows.question'),
    answer: t(locale, 'faq.windows.answer'),
  },
  {
    question: t(locale, 'faq.smartscreen.question'),
    answer: t(locale, 'faq.smartscreen.answer'),
  },
  {
    question: t(locale, 'faq.admin.question'),
    answer: t(locale, 'faq.admin.answer'),
  },
  {
    question: t(locale, 'faq.rollback.question'),
    answer: t(locale, 'faq.rollback.answer'),
  },
];
---

<div class="flex flex-col w-full bg-neutral-950 min-h-screen text-white">
  <NotchiHero
    locale={locale}
    latestTag={latest?.tag}
    downloadUrl={installer?.url ?? versionsHref}
    installerSize={installer ? formatFileSize(installer.size, locale) : undefined}
    allVersionsUrl={versionsHref}
    githubUrl={siteConfig.github.url}
    client:load
  />

  <NotchiBentoGrid locale={locale} client:visible />

  <NotchiScreenshots locale={locale} client:visible />

  <NotchiReleasesSection
    locale={locale}
    latestTag={latest?.tag}
    installerUrl={installer?.url ?? versionsHref}
    portableUrl={versionsHref}
    mobileUrl={mobileHref}
    allReleasesUrl={versionsHref}
    client:visible
  />

  <NotchiRequirements
    locale={locale}
    client:visible
  />

  <NotchiTestimonials
    locale={locale}
    apiUrl={siteConfig.testimonialsApiUrl}
    client:visible
  />

  <NotchiFaq locale={locale} items={faqItems} client:visible />
</div>
