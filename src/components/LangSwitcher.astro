---
import { localizePath, stripLocaleFromPath, t } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
  inverse?: boolean;
}

const { locale, inverse = false } = Astro.props;
const currentPath = stripLocaleFromPath(Astro.url.pathname);

const options = [
  {
    locale: 'en' as const,
    short: 'EN',
    label: t(locale, 'language.english'),
    href: localizePath(currentPath, 'en'),
  },
  {
    locale: 'id' as const,
    short: 'ID',
    label: t(locale, 'language.indonesian'),
    href: localizePath(currentPath, 'id'),
  },
];
---

<div
  class:list={[
    'inline-flex h-10 items-center rounded-xl border-2 p-0.5',
    inverse
      ? 'border-white/40 bg-white/5 shadow-[3px_3px_0_0_var(--accent)]'
      : 'border-line bg-panel shadow-brutal-sm',
  ]}
  role="group"
  aria-label={t(locale, 'language.switch')}
>
  {
    options.map((option) => (
      <a
        href={option.href}
        hreflang={option.locale}
        lang={option.locale}
        aria-current={locale === option.locale ? 'true' : undefined}
        class:list={[
          'flex h-full items-center rounded-lg px-2 text-[0.65rem] font-bold tracking-wider transition-colors',
          locale === option.locale
            ? 'bg-accent text-accent-contrast'
            : inverse
              ? 'text-white/70 hover:text-white'
              : 'text-muted hover:text-ink',
        ]}
      >
        <span aria-hidden="true">{option.short}</span>
        <span class="sr-only">{option.label}</span>
      </a>
    ))
  }
</div>
