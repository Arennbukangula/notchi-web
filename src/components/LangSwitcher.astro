---
import { localizePath, stripLocaleFromPath, t } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
  inverse?: boolean;
}

const { locale } = Astro.props;
const currentPath = stripLocaleFromPath(Astro.url.pathname);

const options = [
  {
    locale: 'en' as const,
    short: 'EN',
    label: t(locale, 'language.english'),
    href: localizePath(currentPath, 'en'),
  },
  {
    locale: 'id' as const,
    short: 'ID',
    label: t(locale, 'language.indonesian'),
    href: localizePath(currentPath, 'id'),
  },
];
---

<div
  class="inline-flex h-8 items-center border border-neutral-800 bg-neutral-900 text-white"
  role="group"
  aria-label={t(locale, 'language.switch')}
>
  {
    options.map((option) => (
      <a
        href={option.href}
        hreflang={option.locale}
        lang={option.locale}
        aria-current={locale === option.locale ? 'true' : undefined}
        class:list={[
          'flex h-full items-center px-2 text-[11px] font-mono font-medium transition-colors',
          locale === option.locale
            ? 'bg-neutral-800 text-white font-semibold'
            : 'text-neutral-400 hover:text-white',
        ]}
      >
        <span aria-hidden="true">{option.short}</span>
        <span class="sr-only">{option.label}</span>
      </a>
    ))
  }
</div>
