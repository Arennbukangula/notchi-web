---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description?: string;
  items: FaqItem[];
}

const { title, description, items } = Astro.props;
---

<section class="mx-auto max-w-3xl px-6 py-20" aria-labelledby="faq-title">
  <div class="text-center">
    <h2 id="faq-title" class="text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h2>
    {
      description && (
        <p class="mt-4 text-base leading-7 text-neutral-600 dark:text-neutral-400">{description}</p>
      )
    }
  </div>

  <div class="mt-10 space-y-3">
    {
      items.map((item) => (
        <details class="group rounded-2xl border border-neutral-200 bg-white p-5 open:bg-neutral-50 dark:border-white/10 dark:bg-white/[0.03] dark:open:bg-white/[0.05]">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left text-sm font-semibold text-neutral-900 [&::-webkit-details-marker]:hidden dark:text-white">
            <span>{item.question}</span>
            <span
              class="text-lg leading-none text-neutral-400 transition-transform group-open:rotate-45 dark:text-neutral-500"
              aria-hidden="true"
            >
              +
            </span>
          </summary>
          <p class="mt-3 text-sm leading-6 text-neutral-600 dark:text-neutral-400">{item.answer}</p>
        </details>
      ))
    }
  </div>
</section>
