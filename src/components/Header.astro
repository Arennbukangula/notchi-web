---
import { localizePath, stripLocaleFromPath, t } from '../i18n';
import type { Locale } from '../i18n';
import { siteConfig } from '../site.config';
import LangSwitcher from './LangSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const currentPath = stripLocaleFromPath(Astro.url.pathname);

const homeHref = localizePath('/', locale);
const versionsHref = localizePath(siteConfig.routes.download, locale);
const docsHref = localizePath(siteConfig.routes.docs, locale);

const links = [
  { href: homeHref, path: '/', label: t(locale, 'nav.home') },
  { href: versionsHref, path: siteConfig.routes.download, label: t(locale, 'nav.versions') },
  { href: docsHref, path: siteConfig.routes.docs, label: t(locale, 'nav.docs') },
];

const isActive = (path: string) =>
  path === '/' ? currentPath === '/' : currentPath === path || currentPath.startsWith(path);
---

<header class="sticky top-0 z-40 border-b-[2.5px] border-line bg-paper">
  <div class="mx-auto flex h-16 max-w-[1120px] items-center gap-3 px-4 sm:h-[72px] sm:px-6">
    <a href={homeHref} class="group flex items-center gap-2.5">
      <span
        class="flex h-10 w-10 items-center justify-center rounded-xl border-2 border-line bg-white shadow-brutal-sm transition-transform group-hover:-rotate-3"
      >
        <img
          src="/images/icon.png"
          alt=""
          width="28"
          height="28"
          class="h-7 w-7 rounded-md"
          loading="eager"
        />
      </span>
      <span class="font-display text-lg leading-none tracking-tight">{siteConfig.appName}</span>
    </a>

    <nav class="ml-4 hidden items-center gap-1 sm:flex" aria-label={t(locale, 'nav.main')}>
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.path) ? 'page' : undefined}
            class:list={[
              'rounded-lg border-2 px-3 py-2 text-sm font-semibold transition-colors',
              isActive(link.path)
                ? 'border-line bg-panel text-ink shadow-brutal-sm'
                : 'border-transparent text-muted hover:border-line hover:bg-panel hover:text-ink',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <LangSwitcher locale={locale} />
      <ThemeToggle locale={locale} />
      <a
        href={siteConfig.github.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex h-10 w-10 items-center justify-center rounded-xl border-2 border-line bg-panel text-ink shadow-brutal-sm transition-colors hover:bg-accent-soft"
        aria-label={t(locale, 'nav.github')}
        title={t(locale, 'nav.github')}
      >
        <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
      </a>
    </div>
  </div>

  <nav class="border-t-2 border-line bg-panel sm:hidden" aria-label={t(locale, 'nav.main')}>
    <div class="flex">
      {
        links.map((link, index) => (
          <a
            href={link.href}
            aria-current={isActive(link.path) ? 'page' : undefined}
            class:list={[
              'flex-1 px-2 py-2.5 text-center text-[0.7rem] font-bold tracking-wider uppercase transition-colors',
              index < links.length - 1 && 'border-r-2 border-line',
              isActive(link.path)
                ? 'bg-accent text-accent-contrast'
                : 'text-muted hover:bg-accent-soft hover:text-ink',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>
