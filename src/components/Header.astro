---
import { localizePath, t } from '../i18n';
import type { Locale } from '../i18n';
import { siteConfig } from '../site.config';
import LangSwitcher from './LangSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const homeHref = localizePath('/', locale);
const versionsHref = localizePath(siteConfig.routes.download, locale);
const docsHref = localizePath(siteConfig.routes.docs, locale);
const navLinkClass =
  'rounded-full px-3 py-2 text-sm text-neutral-600 transition-colors hover:bg-neutral-100 hover:text-neutral-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 dark:text-neutral-300 dark:hover:bg-white/10 dark:hover:text-white';
---

<header
  class="sticky top-0 z-40 border-b border-neutral-200/80 bg-white/80 backdrop-blur-md dark:border-white/10 dark:bg-neutral-950/80"
>
  <div class="mx-auto flex h-16 max-w-[1100px] items-center gap-4 px-6">
    <a
      href={homeHref}
      class="flex items-center gap-2 rounded-full text-neutral-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 dark:text-white"
    >
      <img
        src="/images/icon.png"
        alt=""
        width="28"
        height="28"
        class="h-7 w-7 rounded-lg"
        loading="eager"
      />
      <span class="text-sm font-semibold tracking-tight">{siteConfig.appName}</span>
    </a>

    <nav class="hidden items-center gap-1 sm:flex" aria-label={t(locale, 'nav.main')}>
      <a href={homeHref} class={navLinkClass}>{t(locale, 'nav.home')}</a>
      <a href={versionsHref} class={navLinkClass}>{t(locale, 'nav.versions')}</a>
      <a href={docsHref} class={navLinkClass}>{t(locale, 'nav.docs')}</a>
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <LangSwitcher locale={locale} />
      <ThemeToggle locale={locale} />
      <a
        href={siteConfig.github.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-neutral-200 text-neutral-600 transition-colors hover:bg-neutral-100 hover:text-neutral-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 dark:border-white/10 dark:text-neutral-300 dark:hover:bg-white/10 dark:hover:text-white"
        aria-label={t(locale, 'nav.github')}
        title={t(locale, 'nav.github')}
      >
        <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</header>
