---
import { localizePath, stripLocaleFromPath, t } from '../i18n';
import type { Locale } from '../i18n';
import { siteConfig } from '../site.config';
import LangSwitcher from './LangSwitcher.astro';
import { getReleases } from '../lib/github';
import { formatNumber } from '../lib/format';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const currentPath = stripLocaleFromPath(Astro.url.pathname);

const homeHref = localizePath('/', locale);
const versionsHref = localizePath(siteConfig.routes.download, locale);
const docsHref = localizePath(siteConfig.routes.docs, locale);
const teamHref = localizePath(siteConfig.routes.team, locale);

const links = [
  { href: homeHref, path: '/', label: t(locale, 'nav.home') },
  { href: versionsHref, path: siteConfig.routes.download, label: 'Installer' },
  { href: docsHref, path: siteConfig.routes.docs, label: t(locale, 'nav.docs') },
  { href: teamHref, path: siteConfig.routes.team, label: t(locale, 'nav.team') },
];

const isActive = (path: string) =>
  path === '/' ? currentPath === '/' : currentPath === path || currentPath.startsWith(path);

const releases = await getReleases();
const totalDownloads = releases.reduce((sum, release) => {
  return (
    sum +
    release.assets.reduce((assetSum, asset) => {
      return asset.kind !== 'checksum' ? assetSum + asset.downloadCount : assetSum;
    }, 0)
  );
}, 0);
---

<header class="sticky top-0 z-50 border-b border-neutral-800 bg-neutral-950/90 backdrop-blur-md text-white">
  <div class="mx-auto flex h-14 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-8">
      <a href={homeHref} class="flex items-center gap-2.5 transition-opacity hover:opacity-80">
        <img
          src="/images/icon.png"
          alt=""
          width="22"
          height="22"
          class="size-5 object-contain"
          loading="eager"
        />
        <span class="font-sans text-base font-semibold tracking-tight text-white">{siteConfig.appName}</span>
      </a>

      <nav class="hidden items-center gap-1 md:flex" aria-label={t(locale, 'nav.main')}>
        {
          links.map((link) => (
            <a
              href={link.href}
              aria-current={isActive(link.path) ? 'page' : undefined}
              class:list={[
                'px-3 py-1 text-xs font-medium transition-colors',
                isActive(link.path)
                  ? 'text-white font-semibold'
                  : 'text-neutral-400 hover:text-white',
              ]}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="flex items-center gap-2">
      <LangSwitcher locale={locale} />
      <div
        class="inline-flex h-8 items-center border border-neutral-800 bg-neutral-900 text-white"
        role="group"
      >
        <a
          href={siteConfig.github.url}
          target="_blank"
          rel="noopener noreferrer"
          class="flex h-full items-center justify-center px-2 text-neutral-400 transition-colors hover:bg-neutral-800 hover:text-white"
          aria-label={t(locale, 'nav.github')}
          title={t(locale, 'nav.github')}
        >
          <svg class="size-3.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
            ></path>
          </svg>
        </a>
        <a
          href={versionsHref}
          class="flex h-full items-center border-l border-neutral-800 bg-neutral-800 px-2.5 text-xs font-mono font-medium text-white transition-colors hover:bg-neutral-700"
          title={locale === 'id' ? `Total ${formatNumber(totalDownloads, locale)} kali diunduh di seluruh versi` : `Total ${formatNumber(totalDownloads, locale)} downloads across all versions`}
        >
          <span>{totalDownloads}x</span>
        </a>
      </div>

      <a
        href={versionsHref}
        class="hidden sm:inline-flex h-8 items-center justify-center bg-blue-600 px-3.5 text-xs font-medium text-white transition-colors hover:bg-blue-500 font-mono"
      >
        <span>Installer</span>
      </a>
    </div>
  </div>

  <nav class="border-t border-neutral-800 bg-neutral-950 sm:hidden" aria-label={t(locale, 'nav.main')}>
    <div class="flex">
      {
        links.map((link, index) => (
          <a
            href={link.href}
            aria-current={isActive(link.path) ? 'page' : undefined}
            class:list={[
              'flex-1 px-2 py-2 text-center text-xs font-medium transition-colors',
              index < links.length - 1 && 'border-r border-neutral-800',
              isActive(link.path)
                ? 'bg-neutral-900 text-white font-semibold'
                : 'text-neutral-400 hover:text-white',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>
