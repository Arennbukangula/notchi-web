---
interface Props {
  label: string;
  tone?: 'accent' | 'muted' | 'warning';
}

const { label, tone = 'muted' } = Astro.props;

const toneClass = {
  accent: 'sticker-accent',
  muted: 'bg-panel text-ink',
  warning: 'sticker-ink',
}[tone];
---

<span class:list={['sticker', toneClass]}>
  {label}
</span>
