---
import { localizePath, t } from '../i18n';
import type { Locale } from '../i18n';
import { formatFileSize } from '../lib/format';
import type { Release } from '../lib/github';
import { siteConfig } from '../site.config';

interface Props {
  release?: Release;
  locale: Locale;
}

const { release, locale } = Astro.props;
const installer = release?.primaryInstaller;
---

{
  installer ? (
    <a href={installer.url} class="btn btn-primary btn-lg max-w-full">
      <svg
        class="h-4 w-4 shrink-0"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 3v12" />
        <path d="m7 10 5 5 5-5" />
        <path d="M5 21h14" />
      </svg>
      <span>{t(locale, 'download.cta', { version: release?.tag ?? '' })}</span>
      <span class="hidden text-[0.62rem] tracking-normal sm:inline">
        {formatFileSize(installer.size, locale)}
      </span>
    </a>
  ) : (
    <a
      href={release?.htmlUrl ?? localizePath(siteConfig.routes.download, locale)}
      target={release ? '_blank' : undefined}
      rel={release ? 'noopener noreferrer' : undefined}
      class="btn btn-secondary btn-lg"
    >
      {release ? t(locale, 'download.viewRelease') : t(locale, 'download.unavailable')}
    </a>
  )
}
