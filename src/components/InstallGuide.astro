---
import { localizePath, t } from '../i18n';
import type { Locale } from '../i18n';
import { siteConfig } from '../site.config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const docsHref = localizePath(siteConfig.routes.docs, locale);

const steps = [
  {
    title: t(locale, 'home.install.step1.title'),
    description: t(locale, 'home.install.step1.description'),
  },
  {
    title: t(locale, 'home.install.step2.title'),
    description: t(locale, 'home.install.step2.description'),
  },
  {
    title: t(locale, 'home.install.step3.title'),
    description: t(locale, 'home.install.step3.description'),
  },
];
---

<section class="border-y-[2.5px] border-line bg-panel py-20">
  <div class="mx-auto max-w-[1120px] px-4 sm:px-6">
    <p class="eyebrow">04</p>
    <h2 class="display mt-4 text-3xl sm:text-5xl">
      {t(locale, 'home.install.title')}
    </h2>

    <ol class="mt-10 grid gap-5 sm:grid-cols-3">
      {
        steps.map((step, index) => (
          <li
            class:list={[
              'card-brutal relative overflow-hidden p-6',
              index === 0 && 'bg-accent text-accent-contrast',
            ]}
          >
            <span
              class:list={[
                'font-display absolute -top-1 right-3 text-6xl leading-none',
                index === 0 ? 'text-[#08080b]/70' : 'text-muted/70',
              ]}
              aria-hidden="true"
            >
              {String(index + 1).padStart(2, '0')}
            </span>
            <span
              class:list={[
                'sticker',
                index === 0
                  ? 'border-[#08080b] bg-[#08080b] text-white shadow-[3px_3px_0_0_#08080b]'
                  : 'sticker-accent',
              ]}
            >
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-5 pr-10 text-base font-bold">{step.title}</h3>
            <p
              class:list={['mt-2 text-sm leading-6', index === 0 ? 'text-[#08080b]' : 'text-muted']}
            >
              {step.description}
            </p>
          </li>
        ))
      }
    </ol>

    <div
      class="card-brutal mt-8 grid gap-5 bg-[#08080b] p-6 text-white sm:grid-cols-[auto_1fr_auto] sm:items-start"
    >
      <span
        class="flex h-11 w-11 items-center justify-center rounded-xl border-2 border-white bg-accent font-display text-xl text-accent-contrast shadow-[3px_3px_0_0_#ffffff]"
        aria-hidden="true"
      >
        !
      </span>
      <div class="max-w-2xl">
        <h3 class="text-base font-bold text-white">
          {t(locale, 'home.install.smartScreenTitle')}
        </h3>
        <p class="mt-2 text-sm leading-6 text-white/70">
          {t(locale, 'home.install.smartScreenBody')}
        </p>
      </div>
      <a href={docsHref} class="btn btn-primary btn-sm justify-self-start sm:justify-self-end">
        {t(locale, 'home.install.smartScreenLink')}
      </a>
    </div>

    <p class="mt-6 text-sm text-muted">
      {t(locale, 'home.install.note')}
    </p>
  </div>
</section>
