---
import Badge from './Badge.astro';
import Doodle from './Doodle.astro';
import DownloadButton from './DownloadButton.astro';
import { localizePath, t } from '../i18n';
import type { Locale } from '../i18n';
import { formatFileSize } from '../lib/format';
import type { Release } from '../lib/github';
import { siteConfig } from '../site.config';

interface Props {
  latest?: Release;
  locale: Locale;
}

const { latest, locale } = Astro.props;
const installer = latest?.primaryInstaller;
const versionsHref = localizePath(siteConfig.routes.download, locale);
---

<section class="relative overflow-hidden border-b-[2.5px] border-line">
  <div class="pattern-dots absolute inset-0 opacity-70" aria-hidden="true"></div>
  <div
    class="absolute top-16 -right-24 hidden h-72 w-72 rounded-full border-[3px] border-line bg-accent/15 lg:block"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-[1120px] px-4 pt-12 pb-16 sm:px-6 sm:pt-20 sm:pb-24">
    <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr]">
      <div class="relative">
        <div class="flex flex-wrap items-center gap-2">
          {latest && <Badge label={t(locale, 'home.hero.latest')} tone="accent" />}
          {latest && <span class="sticker -rotate-1">{latest.tag}</span>}
        </div>

        <h1 class="display mt-5 text-[clamp(3.6rem,10vw,7rem)]">Notchi</h1>
        <p class="mt-5 max-w-xl text-lg leading-8 text-muted">
          {t(locale, 'home.hero.tagline')}
        </p>

        {
          latest ? (
            <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
              <DownloadButton release={latest} locale={locale} />
              <a href={versionsHref} class="btn btn-secondary btn-lg">
                {t(locale, 'home.hero.secondary')}
              </a>
            </div>
          ) : (
            <div class="mt-8 flex flex-col items-start gap-3">
              <p class="text-sm font-medium text-muted">{t(locale, 'home.hero.noStable')}</p>
              <a href={versionsHref} class="btn btn-primary btn-lg">
                {t(locale, 'home.hero.browseReleases')}
              </a>
            </div>
          )
        }

        <div class="mt-6 flex flex-wrap items-center gap-2">
          {
            latest && (
              <span class="sticker">
                <span class="h-2 w-2 rounded-full bg-accent" aria-hidden="true" />
                {latest.tag}
              </span>
            )
          }
          <span class="sticker">{t(locale, 'home.platform')}</span>
          {installer && <span class="sticker">{formatFileSize(installer.size, locale)}</span>}
        </div>

        <Doodle
          variant="arrow"
          class="mt-6 hidden h-14 w-20 -rotate-6 text-ink opacity-60 sm:block"
        />

        <p
          id="os-note"
          hidden
          class="mt-6 max-w-md rounded-xl border-2 border-line bg-panel px-4 py-3 text-sm leading-6 text-ink shadow-brutal-sm"
        >
          {t(locale, 'home.hero.nonWindows')}
        </p>
      </div>

      <div class="relative mx-auto w-full max-w-[430px]">
        <Doodle variant="notch" class="w-full" />
        <span class="sticker sticker-accent absolute top-4 right-2 -rotate-3">
          {t(locale, 'home.previews.expanded')}
        </span>
        <Doodle variant="star" class="absolute bottom-4 -left-1 h-10 w-10 rotate-12 sm:left-2" />
        <Doodle variant="sparkle" class="absolute top-10 -left-2 h-8 w-8 -rotate-6 sm:left-0" />
        <Doodle variant="heart" class="absolute right-0 bottom-10 h-8 w-8 rotate-6" />
      </div>
    </div>
  </div>
</section>

<script>
  const note = document.getElementById('os-note');
  if (note && !/Windows/i.test(navigator.userAgent)) note.hidden = false;
</script>
