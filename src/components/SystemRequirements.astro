---
import { t } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const rows = ['os', 'architecture', 'processor', 'memory', 'storage', 'display'] as const;
---

<section class="mx-auto max-w-[1120px] px-4 py-20 sm:px-6" aria-labelledby="requirements-title">
  <div class="max-w-2xl">
    <p class="eyebrow">03</p>
    <h2 id="requirements-title" class="display mt-4 text-3xl sm:text-5xl">
      {t(locale, 'home.requirements.title')}
    </h2>
    <p class="mt-4 text-base leading-7 text-muted">
      {t(locale, 'home.requirements.description')}
    </p>
  </div>

  <div
    class="card-brutal mt-8 overflow-x-auto"
    role="group"
    aria-label={t(locale, 'home.requirements.title')}
    tabindex="0"
  >
    <table class="w-full min-w-[640px] border-collapse text-left text-sm">
      <caption class="sr-only">{t(locale, 'home.requirements.title')}</caption>
      <thead class="border-b-[2.5px] border-line bg-ink text-paper">
        <tr class="text-[0.68rem] font-bold tracking-[0.12em] uppercase">
          <th scope="col" class="px-4 py-4">
            {t(locale, 'home.requirements.component')}
          </th>
          <th scope="col" class="px-4 py-4">
            {t(locale, 'home.requirements.minimum')}
          </th>
          <th scope="col" class="px-4 py-4">
            {t(locale, 'home.requirements.recommended')}
          </th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row, index) => (
            <tr
              class:list={[
                'border-b-2 border-line-soft align-top last:border-b-0',
                index % 2 === 1 ? 'bg-panel-alt/60' : 'bg-panel',
              ]}
            >
              <th scope="row" class="px-4 py-4 font-bold text-ink">
                {t(locale, `home.requirements.${row}.label`)}
              </th>
              <td class="px-4 py-4 text-muted">{t(locale, `home.requirements.${row}.minimum`)}</td>
              <td class="px-4 py-4 text-muted">
                {t(locale, `home.requirements.${row}.recommended`)}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p
    class="mt-5 flex items-start gap-3 rounded-xl border-2 border-line bg-panel px-4 py-3 text-sm text-ink shadow-brutal-sm"
  >
    <span
      class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md border-2 border-line bg-accent font-display text-xs text-accent-contrast"
      aria-hidden="true"
    >
      i
    </span>
    <span class="pt-0.5">{t(locale, 'home.requirements.note')}</span>
  </p>
</section>
