---
import { t } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const previews = [
  {
    title: t(locale, 'home.previews.menu'),
    compact: '/images/ss-menu-close.png',
    expanded: '/images/ss-menu-open.png',
    compactAlt: t(locale, 'home.previews.menuCompactAlt'),
    expandedAlt: t(locale, 'home.previews.menuExpandedAlt'),
    width: 451,
    height: 101,
    expandedWidth: 667,
    expandedHeight: 201,
  },
  {
    title: t(locale, 'home.previews.media'),
    compact: '/images/ss-music-close.png',
    expanded: '/images/ss-music-open.png',
    compactAlt: t(locale, 'home.previews.mediaCompactAlt'),
    expandedAlt: t(locale, 'home.previews.mediaExpandedAlt'),
    width: 460,
    height: 106,
    expandedWidth: 511,
    expandedHeight: 183,
  },
  {
    title: t(locale, 'home.previews.side'),
    compact: '/images/ss-side-music-close.png',
    expanded: '/images/ss-side-music-open.png',
    compactAlt: t(locale, 'home.previews.sideCompactAlt'),
    expandedAlt: t(locale, 'home.previews.sideExpandedAlt'),
    width: 97,
    height: 239,
    expandedWidth: 452,
    expandedHeight: 265,
  },
];
---

<section class="mx-auto max-w-[1120px] px-4 py-20 sm:px-6" aria-labelledby="previews-title">
  <div class="max-w-2xl">
    <p class="eyebrow">01</p>
    <h2 id="previews-title" class="display mt-4 text-3xl sm:text-5xl">
      {t(locale, 'home.previews.title')}
    </h2>
    <p class="mt-4 text-base leading-7 text-muted">
      {t(locale, 'home.previews.description')}
    </p>
  </div>

  <div class="mt-12 border-y-2 border-line-soft">
    {
      previews.map((preview, index) => (
        <figure class="grid gap-4 border-b-2 border-line-soft py-8 last:border-b-0 lg:grid-cols-[220px_1fr] lg:items-center lg:gap-10 lg:py-10">
          <figcaption class="flex items-baseline gap-3 lg:block">
            <span class="font-display text-xs text-accent-ink">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span class="text-sm font-bold text-ink lg:mt-2 lg:block lg:text-lg">
              {preview.title}
            </span>
          </figcaption>

          <div class="flex items-center justify-center gap-3 sm:gap-5 lg:justify-end lg:gap-8">
            <div class="flex min-w-0 flex-col items-center gap-2">
              <img
                src={preview.compact}
                alt={preview.compactAlt}
                width={preview.width}
                height={preview.height}
                loading="lazy"
                decoding="async"
                class="max-h-40 w-auto max-w-[clamp(84px,24vw,200px)] object-contain sm:max-h-48 lg:max-h-52"
              />
              <span class="text-[10px] font-bold tracking-[0.14em] text-muted uppercase">
                {t(locale, 'home.previews.compact')}
              </span>
            </div>
            <span class="shrink-0 text-xl leading-none text-muted sm:text-2xl" aria-hidden="true">
              →
            </span>
            <div class="flex min-w-0 flex-col items-center gap-2">
              <img
                src={preview.expanded}
                alt={preview.expandedAlt}
                width={preview.expandedWidth}
                height={preview.expandedHeight}
                loading="lazy"
                decoding="async"
                class="max-h-28 w-auto max-w-[clamp(160px,42vw,520px)] object-contain sm:max-h-44 lg:max-h-56"
              />
              <span class="text-[10px] font-bold tracking-[0.14em] text-muted uppercase">
                {t(locale, 'home.previews.expanded')}
              </span>
            </div>
          </div>
        </figure>
      ))
    }
  </div>
</section>
