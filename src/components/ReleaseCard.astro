---
import Badge from './Badge.astro';
import { localizePath, t } from '../i18n';
import type { Locale } from '../i18n';
import { formatDate, formatFileSize, formatNumber } from '../lib/format';
import type { Release } from '../lib/github';

interface Props {
  release: Release;
  locale: Locale;
}

const { release, locale } = Astro.props;
const installer = release.primaryInstaller;
const detailHref = localizePath(`/download/${encodeURIComponent(release.version)}/`, locale);
const downloadCount = installer?.downloadCount ?? 0;
---

<li
  data-prerelease={release.prerelease ? 'true' : undefined}
  hidden={release.prerelease}
  class:list={['card-brutal card-hover p-5 sm:p-6', release.isLatestStable && 'bg-accent-soft']}
>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-2">
        <h2 class="font-display text-2xl leading-none tracking-tight text-ink sm:text-3xl">
          {release.tag}
        </h2>
        {release.isLatestStable && <Badge label={t(locale, 'archive.latest')} tone="accent" />}
        {release.prerelease && <Badge label={t(locale, 'archive.prerelease')} tone="warning" />}
      </div>
      <p class="mt-2 text-sm font-medium text-muted">
        {formatDate(release.publishedAt, locale)}
      </p>
    </div>

    <dl class="flex flex-wrap gap-x-5 gap-y-1 text-xs text-muted sm:justify-end">
      <div class="flex items-center gap-1.5">
        <dt>{t(locale, 'archive.size')}</dt>
        <dd class="font-bold text-ink">
          {installer ? formatFileSize(installer.size, locale) : '—'}
        </dd>
      </div>
      <div class="flex items-center gap-1.5">
        <dt class="sr-only">{t(locale, 'archive.downloads')}</dt>
        <dd class="font-bold text-ink">
          {t(locale, 'version.downloads', { count: formatNumber(downloadCount, locale) })}
        </dd>
      </div>
    </dl>
  </div>

  <div class="mt-5 flex flex-wrap items-center gap-2">
    {
      installer ? (
        <a href={installer.url} class="btn btn-primary btn-sm">
          <svg
            class="h-3.5 w-3.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 3v12" />
            <path d="m7 10 5 5 5-5" />
            <path d="M5 21h14" />
          </svg>
          {t(locale, 'archive.download')}
        </a>
      ) : (
        <span class="sticker border-line-soft text-muted">{t(locale, 'archive.noInstaller')}</span>
      )
    }
    <a href={detailHref} class="btn btn-secondary btn-sm">
      {t(locale, 'archive.details')}
    </a>
  </div>
</li>
