---
import Badge from './Badge.astro';
import { localizePath, t } from '../i18n';
import type { Locale } from '../i18n';
import { formatDate, formatFileSize, formatNumber } from '../lib/format';
import type { Release } from '../lib/github';

interface Props {
  release: Release;
  locale: Locale;
}

const { release, locale } = Astro.props;
const installer = release.primaryInstaller;
const detailHref = localizePath(`/download/${encodeURIComponent(release.version)}/`, locale);
const downloadCount = installer?.downloadCount ?? 0;
---

<article
  role="listitem"
  data-prerelease={release.prerelease ? 'true' : undefined}
  hidden={release.prerelease}
  class="rounded-3xl border border-neutral-200 bg-white p-6 transition-colors hover:border-accent/30 dark:border-white/10 dark:bg-white/[0.03] dark:hover:border-accent/40"
>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <div class="flex flex-wrap items-center gap-2">
        <h2 class="text-lg font-semibold tracking-tight text-neutral-900 dark:text-white">
          {release.tag}
        </h2>
        {release.isLatestStable && <Badge label={t(locale, 'archive.latest')} tone="accent" />}
        {release.prerelease && <Badge label={t(locale, 'archive.prerelease')} tone="warning" />}
      </div>
      <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
        {formatDate(release.publishedAt, locale)}
      </p>
    </div>

    <dl class="text-right text-xs text-neutral-500 dark:text-neutral-400">
      <div>
        <dt class="sr-only">{t(locale, 'archive.size')}</dt>
        <dd>{installer ? formatFileSize(installer.size, locale) : '—'}</dd>
      </div>
      <div class="mt-1">
        <dt class="sr-only">{t(locale, 'archive.downloads')}</dt>
        <dd>{t(locale, 'version.downloads', { count: formatNumber(downloadCount, locale) })}</dd>
      </div>
    </dl>
  </div>

  <div class="mt-5 flex flex-wrap items-center gap-2">
    {
      installer ? (
        <a
          href={installer.url}
          class="inline-flex items-center justify-center rounded-full bg-accent px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-accent-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-white dark:focus-visible:ring-offset-neutral-950"
        >
          {t(locale, 'archive.download')}
        </a>
      ) : (
        <span class="rounded-full border border-neutral-200 px-4 py-2 text-sm text-neutral-500 dark:border-white/10 dark:text-neutral-400">
          {t(locale, 'archive.noInstaller')}
        </span>
      )
    }
    <a
      href={detailHref}
      class="inline-flex items-center justify-center rounded-full border border-neutral-200 px-4 py-2 text-sm font-medium text-neutral-700 transition-colors hover:bg-neutral-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent dark:border-white/10 dark:text-neutral-300 dark:hover:bg-white/10"
    >
      {t(locale, 'archive.details')}
    </a>
  </div>
</article>
