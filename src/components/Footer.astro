---
import NotchiFooter from './react/NotchiFooter';
import { localizePath } from '../i18n';
import type { Locale } from '../i18n';
import { siteConfig } from '../site.config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const versionsHref = localizePath(siteConfig.routes.download, locale);
const docsHref = localizePath(siteConfig.routes.docs, locale);
const teamHref = localizePath(siteConfig.routes.team, locale);
const rssHref = localizePath('/rss.xml', locale);
---

<NotchiFooter
  locale={locale}
  allReleasesUrl={versionsHref}
  docsUrl={docsHref}
  teamUrl={teamHref}
  githubUrl={siteConfig.github.url}
  rssUrl={rssHref}
  issuesUrl={siteConfig.github.issuesUrl}
  client:idle
/>
