---
import { localizePath, t } from '../i18n';
import type { Locale } from '../i18n';
import { siteConfig } from '../site.config';
import LangSwitcher from './LangSwitcher.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const versionsHref = localizePath(siteConfig.routes.download, locale);
const docsHref = localizePath(siteConfig.routes.docs, locale);
const rssHref = localizePath('/rss.xml', locale);
const year = new Date().getFullYear();
const linkClass = 'text-sm text-[#c9c9d1] transition-colors hover:text-white';
const headingClass = 'text-xs font-bold tracking-widest text-white uppercase';
---

<footer class="border-t-[3px] border-accent bg-[#08080b] text-[#f4f4f5]">
  <div class="mx-auto max-w-[1120px] px-4 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-6 border-b border-white/15 py-8">
      <p
        class="font-display text-[clamp(3.5rem,13vw,7.5rem)] leading-none tracking-[-0.055em] text-white/40 select-none"
        aria-hidden="true"
      >
        NOTCHI
      </p>
      <span
        class="sticker border-white/40 bg-white/5 text-white shadow-[3px_3px_0_0_var(--accent)]"
      >
        {t(locale, 'home.platform')}
      </span>
    </div>

    <div class="grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-3">
      <div class="space-y-4">
        <a href={localizePath('/', locale)} class="inline-flex items-center gap-3">
          <span
            class="flex h-12 w-12 items-center justify-center rounded-xl border-2 border-white bg-white shadow-[4px_4px_0_0_var(--accent)]"
          >
            <img
              src="/images/icon.png"
              alt=""
              width="32"
              height="32"
              class="h-8 w-8 rounded-md"
              loading="lazy"
            />
          </span>
          <span class="font-display text-xl leading-none">{siteConfig.appName}</span>
        </a>
        <p class="max-w-xs text-sm leading-6 text-[#b9b9c3]">
          {t(locale, 'footer.tagline')}
        </p>
      </div>

      <nav aria-label={t(locale, 'footer.product')}>
        <h2 class={headingClass}>{t(locale, 'footer.product')}</h2>
        <ul class="mt-4 space-y-3">
          <li><a href={versionsHref} class={linkClass}>{t(locale, 'footer.allReleases')}</a></li>
          <li><a href={docsHref} class={linkClass}>{t(locale, 'nav.docs')}</a></li>
          <li>
            <a
              href={siteConfig.github.url}
              target="_blank"
              rel="noopener noreferrer"
              class={linkClass}
            >
              {t(locale, 'footer.source')}
            </a>
          </li>
        </ul>
      </nav>

      <div class="space-y-4">
        <h2 class={headingClass}>{t(locale, 'footer.resources')}</h2>
        <ul class="space-y-3">
          <li>
            <a
              href={siteConfig.github.issuesUrl}
              target="_blank"
              rel="noopener noreferrer"
              class={linkClass}
            >
              {t(locale, 'footer.issues')}
            </a>
          </li>
          <li>
            <a
              href={siteConfig.github.releasesUrl}
              target="_blank"
              rel="noopener noreferrer"
              class={linkClass}
            >
              {t(locale, 'footer.githubReleases')}
            </a>
          </li>
          <li><a href={rssHref} class={linkClass}>{t(locale, 'footer.rss')}</a></li>
        </ul>
        <LangSwitcher locale={locale} inverse />
      </div>
    </div>
  </div>

  <div class="border-t border-white/15">
    <div
      class="mx-auto flex max-w-[1120px] flex-col gap-2 px-4 py-6 text-xs text-[#a7a7b2] sm:flex-row sm:items-center sm:justify-between sm:px-6"
    >
      <p>{t(locale, 'footer.copyright', { year })}</p>
      <p>{t(locale, 'footer.license')}</p>
    </div>
  </div>
</footer>
