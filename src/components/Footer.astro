---
import { localizePath, t } from '../i18n';
import type { Locale } from '../i18n';
import { siteConfig } from '../site.config';
import LangSwitcher from './LangSwitcher.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const versionsHref = localizePath(siteConfig.routes.download, locale);
const docsHref = localizePath(siteConfig.routes.docs, locale);
const year = new Date().getFullYear();
const linkClass =
  'text-sm text-neutral-600 transition-colors hover:text-neutral-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 dark:text-neutral-400 dark:hover:text-white';
---

<footer class="border-t border-neutral-200 bg-white dark:border-white/10 dark:bg-neutral-950">
  <div class="mx-auto grid max-w-[1100px] gap-10 px-6 py-12 sm:grid-cols-2 lg:grid-cols-3">
    <div class="space-y-4">
      <a
        href={localizePath('/', locale)}
        class="inline-flex items-center gap-2 rounded-full text-neutral-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 dark:text-white"
      >
        <img
          src="/images/icon.png"
          alt=""
          width="28"
          height="28"
          class="h-7 w-7 rounded-lg"
          loading="lazy"
        />
        <span class="text-sm font-semibold tracking-tight">{siteConfig.appName}</span>
      </a>
      <p class="max-w-xs text-sm leading-6 text-neutral-500 dark:text-neutral-400">
        {t(locale, 'footer.tagline')}
      </p>
    </div>

    <nav aria-label={t(locale, 'footer.product')}>
      <h2 class="text-xs font-semibold tracking-widest text-neutral-900 uppercase dark:text-white">
        {t(locale, 'footer.product')}
      </h2>
      <ul class="mt-4 space-y-3">
        <li><a href={versionsHref} class={linkClass}>{t(locale, 'footer.allReleases')}</a></li>
        <li><a href={docsHref} class={linkClass}>{t(locale, 'nav.docs')}</a></li>
        <li>
          <a
            href={siteConfig.github.url}
            target="_blank"
            rel="noopener noreferrer"
            class={linkClass}
          >
            {t(locale, 'footer.source')}
          </a>
        </li>
      </ul>
    </nav>

    <div class="space-y-4">
      <h2 class="text-xs font-semibold tracking-widest text-neutral-900 uppercase dark:text-white">
        {t(locale, 'footer.resources')}
      </h2>
      <ul class="space-y-3">
        <li>
          <a
            href={siteConfig.github.issuesUrl}
            target="_blank"
            rel="noopener noreferrer"
            class={linkClass}
          >
            {t(locale, 'footer.issues')}
          </a>
        </li>
        <li>
          <a
            href={siteConfig.github.releasesUrl}
            target="_blank"
            rel="noopener noreferrer"
            class={linkClass}
          >
            {t(locale, 'footer.githubReleases')}
          </a>
        </li>
      </ul>
      <LangSwitcher locale={locale} />
    </div>
  </div>

  <div class="border-t border-neutral-200 dark:border-white/10">
    <div
      class="mx-auto flex max-w-[1100px] flex-col gap-2 px-6 py-6 text-xs text-neutral-500 sm:flex-row sm:items-center sm:justify-between dark:text-neutral-400"
    >
      <p>{t(locale, 'footer.copyright', { year })}</p>
      <p>{t(locale, 'footer.license')}</p>
    </div>
  </div>
</footer>
