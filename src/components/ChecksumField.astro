---
import { t } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  file: string;
  hash?: string;
  locale: Locale;
}

const { file, hash, locale } = Astro.props;
const commandFile = /\s/.test(file) ? `"${file}"` : file;
const command = t(locale, 'download.verifyCommand', { file: commandFile });
---

<div
  class="rounded-3xl border border-neutral-200 bg-white p-6 dark:border-white/10 dark:bg-white/[0.03]"
>
  <h2
    class="text-sm font-semibold tracking-widest text-neutral-500 uppercase dark:text-neutral-400"
  >
    {t(locale, 'version.checksumTitle')}
  </h2>

  {
    hash ? (
      <div class="mt-4 space-y-4">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <code class="text-sm break-all text-neutral-900 dark:text-neutral-100">{hash}</code>
          <button
            type="button"
            data-copy-checksum={hash}
            data-label-copy={t(locale, 'download.copy')}
            data-label-copied={t(locale, 'download.copied')}
            data-label-failed={t(locale, 'download.copyFailed')}
            class="inline-flex shrink-0 items-center gap-2 rounded-full border border-neutral-200 px-3 py-1.5 text-xs font-medium text-neutral-700 transition-colors hover:bg-neutral-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent dark:border-white/10 dark:text-neutral-300 dark:hover:bg-white/10"
          >
            <svg
              class="h-3.5 w-3.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="9" y="9" width="11" height="11" rx="2" />
              <path d="M5 15V5a2 2 0 0 1 2-2h10" />
            </svg>
            <span data-copy-label>{t(locale, 'download.copy')}</span>
          </button>
        </div>

        <div class="border-t border-neutral-200 pt-4 dark:border-white/10">
          <h3 class="text-sm font-semibold text-neutral-900 dark:text-white">
            {t(locale, 'version.verifyTitle')}
          </h3>
          <p class="mt-2 text-sm leading-6 text-neutral-600 dark:text-neutral-400">
            {t(locale, 'version.verifyHint')}
          </p>
          <pre class="mt-3 overflow-x-auto rounded-2xl bg-neutral-950 px-4 py-3 text-xs text-neutral-100">
            <code>{command}</code>
          </pre>
        </div>

        <p class="sr-only" role="status" data-copy-status />
      </div>
    ) : (
      <p class="mt-4 text-sm text-neutral-500 dark:text-neutral-400">
        {t(locale, 'download.checksumUnavailable')}
      </p>
    )
  }
</div>

<script>
  async function copyText(value: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(value);
      return true;
    } catch {
      return false;
    }
  }

  document.querySelectorAll<HTMLButtonElement>('[data-copy-checksum]').forEach((button) => {
    button.addEventListener('click', async () => {
      const value = button.dataset.copyChecksum;
      if (!value) return;

      const copied = await copyText(value);
      const label = button.querySelector<HTMLElement>('[data-copy-label]');
      const status =
        button.parentElement?.parentElement?.querySelector<HTMLElement>('[data-copy-status]');

      if (label) {
        label.textContent = copied
          ? (button.dataset.labelCopied ?? '')
          : (button.dataset.labelFailed ?? '');
      }
      if (status) {
        status.textContent = copied
          ? (button.dataset.labelCopied ?? '')
          : (button.dataset.labelFailed ?? '');
      }

      window.setTimeout(() => {
        if (label) label.textContent = button.dataset.labelCopy ?? '';
      }, 2000);
    });
  });
</script>
