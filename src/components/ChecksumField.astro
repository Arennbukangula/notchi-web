---
import { t } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  file: string;
  hash?: string;
  locale: Locale;
}

const { file, hash, locale } = Astro.props;
const commandFile = /\s/.test(file) ? `"${file}"` : file;
const command = t(locale, 'download.verifyCommand', { file: commandFile });
---

<div class="card-brutal p-5 sm:p-6">
  <h2 class="eyebrow">{t(locale, 'version.checksumTitle')}</h2>

  {
    hash ? (
      <div class="mt-4 space-y-5">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <code class="rounded-lg border-2 border-line bg-panel-alt px-3 py-2 text-xs break-all text-ink">
            {hash}
          </code>
          <button
            type="button"
            data-copy-checksum={hash}
            data-label-copy={t(locale, 'download.copy')}
            data-label-copied={t(locale, 'download.copied')}
            data-label-failed={t(locale, 'download.copyFailed')}
            class="btn btn-secondary btn-sm shrink-0"
          >
            <svg
              class="h-3.5 w-3.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="9" y="9" width="11" height="11" rx="2" />
              <path d="M5 15V5a2 2 0 0 1 2-2h10" />
            </svg>
            <span data-copy-label>{t(locale, 'download.copy')}</span>
          </button>
        </div>

        <div class="border-t-2 border-line-soft pt-4">
          <h3 class="text-sm font-bold text-ink">{t(locale, 'version.verifyTitle')}</h3>
          <p class="mt-2 text-sm leading-6 text-muted">{t(locale, 'version.verifyHint')}</p>
          <pre class="code-block mt-3" tabindex="0">
            <code>{command}</code>
          </pre>
        </div>

        <p class="sr-only" role="status" data-copy-status />
      </div>
    ) : (
      <p class="mt-4 text-sm text-muted">{t(locale, 'download.checksumUnavailable')}</p>
    )
  }
</div>

<script>
  async function copyText(value: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(value);
      return true;
    } catch {
      return false;
    }
  }

  document.querySelectorAll<HTMLButtonElement>('[data-copy-checksum]').forEach((button) => {
    button.addEventListener('click', async () => {
      const value = button.dataset.copyChecksum;
      if (!value) return;

      const copied = await copyText(value);
      const label = button.querySelector<HTMLElement>('[data-copy-label]');
      const status =
        button.parentElement?.parentElement?.querySelector<HTMLElement>('[data-copy-status]');

      if (label) {
        label.textContent = copied
          ? (button.dataset.labelCopied ?? '')
          : (button.dataset.labelFailed ?? '');
      }
      if (status) {
        status.textContent = copied
          ? (button.dataset.labelCopied ?? '')
          : (button.dataset.labelFailed ?? '');
      }

      window.setTimeout(() => {
        if (label) label.textContent = button.dataset.labelCopy ?? '';
      }, 2000);
    });
  });
</script>
