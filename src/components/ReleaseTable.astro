---
import ReleaseCard from './ReleaseCard.astro';
import { t } from '../i18n';
import type { Locale } from '../i18n';
import type { Release } from '../lib/github';

interface Props {
  releases: Release[];
  locale: Locale;
}

const { releases, locale } = Astro.props;
const hasPrereleases = releases.some((release) => release.prerelease);
---

{
  hasPrereleases && (
    <div class="mb-6 flex justify-end">
      <button
        id="prerelease-toggle"
        type="button"
        aria-pressed="false"
        aria-controls="release-list"
        data-label-show={t(locale, 'archive.showPrereleases')}
        data-label-hide={t(locale, 'archive.hidePrereleases')}
        class="btn btn-secondary btn-sm aria-pressed:bg-accent aria-pressed:text-accent-contrast"
      >
        <span class="h-2 w-2 rounded-full border border-current bg-current" aria-hidden="true" />
        <span data-toggle-label>{t(locale, 'archive.showPrereleases')}</span>
      </button>
    </div>
  )
}

<ul id="release-list" class="list-none space-y-4" aria-label={t(locale, 'a11y.releaseList')}>
  {releases.map((release) => <ReleaseCard release={release} locale={locale} />)}
</ul>

<script>
  const toggle = document.getElementById('prerelease-toggle');
  const list = document.getElementById('release-list');

  if (toggle instanceof HTMLButtonElement && list) {
    const label = toggle.querySelector<HTMLElement>('[data-toggle-label]');

    toggle.addEventListener('click', () => {
      const show = toggle.getAttribute('aria-pressed') !== 'true';
      toggle.setAttribute('aria-pressed', String(show));
      if (label) {
        label.textContent = show
          ? (toggle.dataset.labelHide ?? '')
          : (toggle.dataset.labelShow ?? '');
      }

      list.querySelectorAll<HTMLElement>('[data-prerelease]').forEach((item) => {
        item.hidden = !show;
      });
    });
  }
</script>
