---
import MobileDownloadPage from '../../components/pages/MobileDownloadPage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n';
import type { Locale } from '../../i18n';
import { getMobileReleases } from '../../lib/mobile';

const locale: Locale = 'en';
const releases = await getMobileReleases();
---

<BaseLayout
  locale={locale}
  title={t(locale, 'mobile.title')}
  description={t(locale, 'mobile.description')}
>
  <MobileDownloadPage releases={releases} locale={locale} />
</BaseLayout>
