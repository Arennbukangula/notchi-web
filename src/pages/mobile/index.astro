---
import DownloadPage from '../../components/pages/DownloadPage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Locale } from '../../i18n';
import { getReleases } from '../../lib/github';
import { getMobileReleases } from '../../lib/mobile';

const locale: Locale = 'en';
const releases = await getReleases();
const mobileReleases = await getMobileReleases();
---

<BaseLayout
  locale={locale}
  title="Installer - Mobile"
  description="Download official Notchi Mobile companion releases for Android."
>
  <DownloadPage
    releases={releases}
    mobileReleases={mobileReleases}
    locale={locale}
    initialTab="mobile"
  />
</BaseLayout>
