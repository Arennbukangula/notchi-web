---
import BaseLayout from '../layouts/BaseLayout.astro';
import Doodle from '../components/Doodle.astro';
import { localizePath, t } from '../i18n';
import type { Locale } from '../i18n';
import { siteConfig } from '../site.config';

const locale: Locale = 'en';
---

<BaseLayout
  locale={locale}
  title={t(locale, 'notFound.title')}
  description={t(locale, 'notFound.description')}
  noindex
>
  <section class="pattern-dots relative overflow-hidden">
    <div
      class="mx-auto flex max-w-3xl flex-col items-center px-4 py-16 text-center sm:px-6 sm:py-24"
    >
      <span class="sticker sticker-accent -rotate-2">404</span>
      <p
        class="display text-outline mt-3 text-[clamp(6rem,24vw,11rem)] leading-none"
        aria-hidden="true"
      >
        404
      </p>
      <Doodle variant="notch" class="-mt-10 w-full max-w-[300px]" />
      <h1 class="display mt-4 text-4xl sm:text-5xl">{t(locale, 'notFound.title')}</h1>
      <p class="mt-4 max-w-xl text-base leading-7 text-muted">
        {t(locale, 'notFound.body')}
      </p>

      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={localizePath(siteConfig.routes.home, locale)} class="btn btn-primary btn-lg">
          {t(locale, 'notFound.home')}
        </a>
        <a href={localizePath(siteConfig.routes.download, locale)} class="btn btn-secondary btn-lg">
          {t(locale, 'notFound.versions')}
        </a>
        <a href={localizePath(siteConfig.routes.docs, locale)} class="btn btn-secondary btn-lg">
          {t(locale, 'notFound.docs')}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
