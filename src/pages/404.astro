---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localizePath, t } from '../i18n';
import type { Locale } from '../i18n';
import { siteConfig } from '../site.config';

const locale: Locale = 'en';
const buttonClass =
  'inline-flex items-center justify-center rounded-full bg-accent px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-accent-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-50 dark:focus-visible:ring-offset-neutral-950';
const mutedClass =
  'inline-flex items-center justify-center rounded-full border border-neutral-200 bg-white px-5 py-3 text-sm font-medium text-neutral-700 transition-colors hover:bg-neutral-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent dark:border-white/10 dark:bg-white/5 dark:text-neutral-300 dark:hover:bg-white/10';
---

<BaseLayout
  locale={locale}
  title={t(locale, 'notFound.title')}
  description={t(locale, 'notFound.description')}
  noindex
>
  <section class="mx-auto flex max-w-2xl flex-col items-center px-6 py-24 text-center sm:py-32">
    <p class="text-sm font-semibold tracking-widest text-accent uppercase">404</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">
      {t(locale, 'notFound.title')}
    </h1>
    <p class="mt-4 text-base leading-7 text-neutral-600 dark:text-neutral-400">
      {t(locale, 'notFound.body')}
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={localizePath(siteConfig.routes.home, locale)} class={buttonClass}>
        {t(locale, 'notFound.home')}
      </a>
      <a href={localizePath(siteConfig.routes.download, locale)} class={mutedClass}>
        {t(locale, 'notFound.versions')}
      </a>
      <a href={localizePath(siteConfig.routes.docs, locale)} class={mutedClass}>
        {t(locale, 'notFound.docs')}
      </a>
    </div>
  </section>
</BaseLayout>
