# Optional: raises the GitHub API rate limit during builds.
# Use a read-only token for the public repository.
GITHUB_TOKEN=
# Source repository for releases.
GITHUB_OWNER=Risunity
GITHUB_REPO=Notchi

# Public canonical URL of the site (used for canonical links, sitemap and RSS).
SITE_URL=https://notchi-web-tau.vercel.app

# Upstash Redis (REST API connection for claims, counter, rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob (read/write token for rewards image storage)
BLOB_READ_WRITE_TOKEN=

# Ed25519 Private Key for offline-friendly entitlement signing (PEM format, or base64 PEM)
ENTITLEMENT_PRIVATE_KEY=

# Salt for hashing user IP addresses for privacy & rate limiting
IP_HASH_SALT=

# Cloudflare Turnstile anti-bot verification
TURNSTILE_SECRET_KEY=
PUBLIC_TURNSTILE_SITE_KEY=
